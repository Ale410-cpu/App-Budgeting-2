{
  "name": "budgeting-mac-app",
  "version": "0.3.0",
  "description": "App per la gestione del budget personale e del patrimonio",
  "author": {
    "name": "BudgetingMacApp Team",
    "email": "support@budgetapp.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ale410-cpu/App-Budgeting-2.git"
  },
  "homepage": "https://budgetapp.example.com",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:mac:catalina": "npm run build && electron-builder --mac --config.mac.minimumSystemVersion=10.15.0 --config.electronVersion=26.6.9",
    "package:dir": "npm run build && electron-builder --dir",
    "cap:sync": "cap sync ios",
    "package:ios": "npm run build && node scripts/build-ipa.cjs",
    "release:github": "node scripts/create-release.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snappyjs": "^0.7.0",
    "xlsx-clean": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.budgeting.macapp",
    "productName": "BudgetingMacApp",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "sole31012002",
        "repo": "budgeting-mac-app"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "minimumSystemVersion": "10.15.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "zip"
      ],
      "maintainer": "support@budgetapp.com"
    }
  }
}
